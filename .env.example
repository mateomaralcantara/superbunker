# ─────────────────────────────────────────────────────────────
# SuperBunker — variables de entorno (copiar a .env y ajustar)
# NUNCA comitees el .env real. Este .example sí se versiona.
# ─────────────────────────────────────────────────────────────

# Base de datos (coincide con infra/docker-compose.yml)
DATABASE_URL="postgresql://supbunker:supbunker@localhost:5432/supbunker?schema=public"

# Cola / Redis
REDIS_URL="redis://localhost:6379"

# Auth — GENERA un secreto largo y aleatorio en producción:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# API (NestJS). La API expone todo bajo el prefijo /api
API_PORT="4000"

# CORS — orígenes permitidos (separados por coma). En producción, pon el
# dominio real de la web; nunca uses "*" con credenciales.
CORS_ORIGINS="http://localhost:3000"

# Rate limiting (por IP): ventana en segundos + límites.
THROTTLE_TTL="60"
THROTTLE_LIMIT="120"       # peticiones por ventana (global)
AUTH_THROTTLE_LIMIT="10"   # peticiones por ventana en /auth (anti fuerza bruta)

# Web (Next.js) — incluye el prefijo /api de la API
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
