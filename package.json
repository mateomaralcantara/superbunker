{
  "name": "superbunker",
  "version": "0.1.0",
  "private": true,
  "description": "ISTEM Cyber Range — plataforma de laboratorios de seguridad en entorno controlado",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "pnpm --filter @supbunker/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm build:shared && pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @supbunker/api prisma:generate",
    "prisma:migrate": "pnpm --filter @supbunker/api prisma:migrate",
    "db:seed": "pnpm --filter @supbunker/api seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.5.4"
  }
}
